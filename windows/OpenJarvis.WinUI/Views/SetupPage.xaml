<Page
    x:Class="OpenJarvis.WinUI.Views.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="720" Spacing="16">
            <TextBlock Text="Set up OpenJarvis" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="This installs Foundry Local (Windows ML) if needed, then downloads the default model and execution providers. After setup, chat works without a network. No terminal or Visual Studio is required."
                TextWrapping="Wrap" />
            <ProgressBar
                x:Name="SetupProgress"
                Minimum="0"
                Maximum="100"
                IsIndeterminate="False"
                AutomationProperties.Name="Setup progress" />
            <TextBlock
                x:Name="SetupStatus"
                Text="Waiting to start…"
                TextWrapping="Wrap"
                AutomationProperties.LiveSetting="Polite" />
            <InfoBar
                x:Name="SetupError"
                IsOpen="False"
                Severity="Error"
                IsClosable="True"
                Title="Setup could not finish" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="StartButton"
                    Content="Start setup"
                    MinWidth="120"
                    MinHeight="40"
                    Click="Start_Click"
                    AccessKey="S"
                    AutomationProperties.Name="Start setup" />
                <Button
                    x:Name="SkipButton"
                    Content="Skip for now"
                    MinWidth="120"
                    MinHeight="40"
                    Click="Skip_Click"
                    AutomationProperties.Name="Skip setup" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
