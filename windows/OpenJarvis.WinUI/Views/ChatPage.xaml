<Page
    x:Class="OpenJarvis.WinUI.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OpenJarvis.WinUI.Models">
    <Grid Padding="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button
                x:Name="NewChatButton"
                Content="New chat"
                HorizontalAlignment="Stretch"
                MinHeight="40"
                Click="NewChat_Click"
                AccessKey="N"
                AutomationProperties.Name="Start a new chat"
                Margin="0,0,0,12" />
            <ListView
                x:Name="ConversationList"
                Grid.Row="1"
                SelectionChanged="ConversationList_SelectionChanged"
                AutomationProperties.Name="Conversation history">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Conversation">
                        <Grid Padding="4,4,0,4" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{x:Bind Model}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                MinWidth="36"
                                MinHeight="36"
                                Padding="8"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                PointerPressed="DeleteChat_PointerPressed"
                                Click="DeleteChat_Click"
                                Tag="{x:Bind Id}"
                                ToolTipService.ToolTip="Delete chat"
                                AutomationProperties.Name="Delete chat">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                <ComboBox
                    x:Name="ModelBox"
                    Header="Model"
                    MinWidth="220"
                    SelectionChanged="ModelBox_SelectionChanged"
                    AutomationProperties.Name="Model" />
                <ComboBox
                    x:Name="AgentBox"
                    Header="Agent"
                    MinWidth="160"
                    SelectionChanged="AgentBox_SelectionChanged"
                    AutomationProperties.Name="Agent" />
                <TextBlock
                    x:Name="HardwareText"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap"
                    AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

            <ListView
                x:Name="MessageList"
                Grid.Row="1"
                IsItemClickEnabled="False"
                SelectionMode="None"
                AutomationProperties.Name="Messages">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatMessage">
                        <StackPanel Margin="0,0,0,16" Spacing="4">
                            <TextBlock Text="{x:Bind Role, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Content, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ItemsControl x:Name="ToolList" Grid.Row="2" Margin="0,8,0,8" AutomationProperties.Name="Tool activity">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ToolCallInfo">
                        <InfoBar
                            IsOpen="True"
                            IsClosable="False"
                            Title="{x:Bind Tool}"
                            Message="{x:Bind Status}"
                            Severity="Informational" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="PromptBox"
                    Header="Message"
                    PlaceholderText="Ask OpenJarvis"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    Height="88"
                    AccessKey="M"
                    AutomationProperties.Name="Message"
                    KeyDown="PromptBox_KeyDown" />
                <Button
                    x:Name="SendButton"
                    Grid.Column="1"
                    Content="Send"
                    MinWidth="88"
                    MinHeight="40"
                    Margin="8,24,0,0"
                    Click="Send_Click"
                    AccessKey="S"
                    AutomationProperties.Name="Send message" />
                <Button
                    x:Name="CancelButton"
                    Grid.Column="2"
                    Content="Stop"
                    MinWidth="88"
                    MinHeight="40"
                    Margin="8,24,0,0"
                    Click="Cancel_Click"
                    IsEnabled="False"
                    AccessKey="X"
                    AutomationProperties.Name="Stop generation" />
            </Grid>
        </Grid>
    </Grid>
</Page>
