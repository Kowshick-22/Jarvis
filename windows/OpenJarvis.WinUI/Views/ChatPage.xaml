<Page
    x:Class="OpenJarvis.WinUI.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OpenJarvis.WinUI.Models"
    xmlns:views="using:OpenJarvis.WinUI.Views"
    xmlns:converters="using:OpenJarvis.WinUI.Converters"
    xmlns:ctk="using:CommunityToolkit.WinUI.UI.Controls">
    <Page.Resources>
        <converters:StatusBrushConverter x:Key="StatusBrushConverter" />

        <DataTemplate x:Key="UserMessageTemplate" x:DataType="models:ChatMessage">
            <Grid Margin="0,0,0,16" PointerEntered="MessageRow_PointerEntered" PointerExited="MessageRow_PointerExited">
                <StackPanel HorizontalAlignment="Right" MaxWidth="560" Spacing="4">
                    <Border
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="12,12,2,12"
                        Padding="12,8">
                        <TextBlock
                            Text="{x:Bind Content, Mode=OneWay}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <Button
                        x:Name="CopyButton"
                        Tag="{x:Bind}"
                        HorizontalAlignment="Right"
                        Opacity="0"
                        Style="{StaticResource FlatIconButtonStyle}"
                        Click="CopyMessage_Click"
                        ToolTipService.ToolTip="Copy message"
                        AutomationProperties.Name="Copy message">
                        <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AssistantMessageTemplate" x:DataType="models:ChatMessage">
            <Grid Margin="0,0,0,16" PointerEntered="MessageRow_PointerEntered" PointerExited="MessageRow_PointerExited">
                <StackPanel Spacing="4">
                    <ctk:MarkdownTextBlock
                        Text="{x:Bind Content, Mode=OneWay}"
                        Background="Transparent"
                        TextWrapping="Wrap"
                        UseSyntaxHighlighting="True"
                        IsTextSelectionEnabled="True"
                        CodeBackground="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CodeBorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        CodeBorderThickness="1"
                        CodeMargin="0,4,4,4"
                        CodePadding="12,8"
                        InlineCodeBackground="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        QuoteBorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Button
                        x:Name="CopyButton"
                        Tag="{x:Bind}"
                        HorizontalAlignment="Left"
                        Opacity="0"
                        Style="{StaticResource FlatIconButtonStyle}"
                        Click="CopyMessage_Click"
                        ToolTipService.ToolTip="Copy message"
                        AutomationProperties.Name="Copy message">
                        <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <views:ChatMessageTemplateSelector
            x:Key="MessageTemplateSelector"
            UserTemplate="{StaticResource UserMessageTemplate}"
            AssistantTemplate="{StaticResource AssistantMessageTemplate}" />
    </Page.Resources>
    <Grid x:Name="RootGrid" Padding="16" SizeChanged="RootGrid_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="260" />
            <ColumnDefinition x:Name="SidebarGapColumn" Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="Sidebar" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,8" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="ToggleSidebarButton"
                    Grid.Column="0"
                    Click="ToggleSidebar_Click"
                    Style="{StaticResource FlatIconButtonStyle}"
                    ToolTipService.ToolTip="Hide chats"
                    AutomationProperties.Name="Hide conversation list">
                    <FontIcon Glyph="&#xE126;" FontSize="14" />
                </Button>
                <TextBlock
                    Grid.Column="1"
                    Text="Chats"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    VerticalAlignment="Center"
                    Margin="4,0,0,0" />
            </Grid>

            <Button
                x:Name="NewChatButton"
                Grid.Row="1"
                Content="New chat"
                HorizontalAlignment="Stretch"
                MinHeight="40"
                Click="NewChat_Click"
                AccessKey="N"
                AutomationProperties.Name="Start a new chat"
                Margin="0,0,0,8" />

            <AutoSuggestBox
                x:Name="ConversationSearchBox"
                Grid.Row="2"
                PlaceholderText="Search chats"
                QueryIcon="Find"
                TextChanged="ConversationSearchBox_TextChanged"
                Margin="0,0,0,8"
                AutomationProperties.Name="Search chats" />

            <ListView
                x:Name="ConversationList"
                Grid.Row="3"
                SelectionChanged="ConversationList_SelectionChanged"
                AutomationProperties.Name="Conversation history">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Conversation">
                        <Grid Padding="4,4,0,4" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{x:Bind Model}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                MinWidth="36"
                                MinHeight="36"
                                Padding="8"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                PointerPressed="DeleteChat_PointerPressed"
                                Click="DeleteChat_Click"
                                Tag="{x:Bind Id}"
                                ToolTipService.ToolTip="Delete chat"
                                AutomationProperties.Name="Delete chat">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <views:SidebarResizeGrip
            x:Name="SidebarSplitter"
            Grid.Column="1"
            Background="Transparent"
            IsTabStop="True"
            PointerPressed="SidebarSplitter_PointerPressed"
            PointerMoved="SidebarSplitter_PointerMoved"
            PointerReleased="SidebarSplitter_PointerReleased"
            PointerCaptureLost="SidebarSplitter_PointerCaptureLost"
            PointerEntered="SidebarSplitter_PointerEntered"
            PointerExited="SidebarSplitter_PointerExited"
            KeyDown="SidebarSplitter_KeyDown"
            ToolTipService.ToolTip="Drag to resize"
            AutomationProperties.Name="Resize conversation list">
            <Border
                x:Name="SidebarSplitterBar"
                Width="2"
                HorizontalAlignment="Center"
                Opacity="0.6"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </views:SidebarResizeGrip>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,12" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="ReopenSidebarButton"
                    VerticalAlignment="Bottom"
                    MinWidth="40"
                    MinHeight="40"
                    Visibility="Collapsed"
                    Click="ToggleSidebar_Click"
                    ToolTipService.ToolTip="Show chats"
                    AutomationProperties.Name="Show conversation list">
                    <FontIcon Glyph="&#xE127;" FontSize="16" />
                </Button>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    MinWidth="40"
                    MinHeight="40"
                    Click="ToggleTheme_Click"
                    ToolTipService.ToolTip="Toggle theme"
                    AutomationProperties.Name="Toggle theme">
                    <FontIcon x:Name="ThemeToggleIcon" Glyph="&#xE793;" FontSize="16" />
                </Button>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                    <ComboBox
                        x:Name="ModelBox"
                        Header="Model"
                        MinWidth="220"
                        SelectionChanged="ModelBox_SelectionChanged"
                        AutomationProperties.Name="Model" />
                    <ComboBox
                        x:Name="AgentBox"
                        Header="Agent"
                        MinWidth="160"
                        SelectionChanged="AgentBox_SelectionChanged"
                        AutomationProperties.Name="Agent" />
                    <TextBlock
                        x:Name="HardwareText"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Grid>

            <ListView
                x:Name="MessageList"
                Grid.Row="1"
                IsItemClickEnabled="False"
                SelectionMode="None"
                ItemTemplateSelector="{StaticResource MessageTemplateSelector}"
                AutomationProperties.Name="Messages" />

            <ItemsControl x:Name="ToolList" Grid.Row="2" Margin="0,0,0,8" AutomationProperties.Name="Tool activity">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ToolCallInfo">
                        <Expander
                            Margin="0,0,0,4"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressRing
                                        Grid.Column="0"
                                        Width="14"
                                        Height="14"
                                        IsActive="{x:Bind IsRunning, Mode=OneWay}"
                                        Visibility="{x:Bind IsRunning, Mode=OneWay}" />
                                    <FontIcon
                                        Grid.Column="0"
                                        FontSize="14"
                                        Glyph="{x:Bind StatusGlyph, Mode=OneWay}"
                                        Foreground="{x:Bind StatusBrushKey, Mode=OneWay, Converter={StaticResource StatusBrushConverter}}"
                                        Visibility="{x:Bind IsDone, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind Tool, Mode=OneWay}"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{x:Bind ArgumentsPreview, Mode=OneWay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Opacity="0.7"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{x:Bind LatencyLabel, Mode=OneWay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </Expander.Header>
                            <StackPanel Spacing="8" Padding="4,8,4,4">
                                <TextBlock Text="args" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                                <Border Style="{StaticResource CardBorderStyle}" Padding="8" MaxHeight="160">
                                    <ScrollViewer VerticalScrollMode="Auto">
                                        <TextBlock
                                            Text="{x:Bind Arguments, Mode=OneWay}"
                                            FontFamily="Consolas"
                                            TextWrapping="Wrap"
                                            IsTextSelectionEnabled="True" />
                                    </ScrollViewer>
                                </Border>
                                <TextBlock Text="result" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                                <Border Style="{StaticResource CardBorderStyle}" Padding="8" MaxHeight="180">
                                    <ScrollViewer VerticalScrollMode="Auto">
                                        <TextBlock
                                            Text="{x:Bind Result, Mode=OneWay}"
                                            FontFamily="Consolas"
                                            TextWrapping="Wrap"
                                            IsTextSelectionEnabled="True" />
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="PromptBox"
                    Header="Message"
                    PlaceholderText="Ask OpenJarvis"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    Height="88"
                    AccessKey="M"
                    AutomationProperties.Name="Message"
                    KeyDown="PromptBox_KeyDown" />
                <Button
                    x:Name="SendButton"
                    Grid.Column="1"
                    Content="Send"
                    MinWidth="88"
                    MinHeight="40"
                    Margin="8,24,0,0"
                    Click="Send_Click"
                    AccessKey="S"
                    AutomationProperties.Name="Send message" />
                <Button
                    x:Name="CancelButton"
                    Grid.Column="2"
                    Content="Stop"
                    MinWidth="88"
                    MinHeight="40"
                    Margin="8,24,0,0"
                    Click="Cancel_Click"
                    IsEnabled="False"
                    AccessKey="X"
                    AutomationProperties.Name="Stop generation" />
            </Grid>
        </Grid>
    </Grid>
</Page>
