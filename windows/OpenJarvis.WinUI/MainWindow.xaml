<Window
    x:Class="OpenJarvis.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="OpenJarvis">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView
            x:Name="NavView"
            IsSettingsVisible="True"
            IsBackButtonVisible="Collapsed"
            PaneDisplayMode="Left"
            OpenPaneLength="260"
            CompactPaneLength="48"
            SelectionChanged="NavView_SelectionChanged"
            AutomationProperties.Name="OpenJarvis navigation">
            <NavigationView.PaneHeader>
                <StackPanel Margin="12,8,12,0" Spacing="4">
                    <TextBlock Text="OpenJarvis" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        x:Name="StatusText"
                        Text="Starting…"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Chat" Tag="chat" AccessKey="C" AutomationProperties.Name="Chat">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Dashboard" Tag="dashboard" AccessKey="D" AutomationProperties.Name="Dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Data Sources" Tag="datasources" AccessKey="S" AutomationProperties.Name="Data Sources">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDA2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Agents" Tag="agents" AccessKey="G" AutomationProperties.Name="Agents">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE99A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Approvals" Tag="approvals" AccessKey="A" AutomationProperties.Name="Approvals">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Logs" Tag="logs" AccessKey="L" AutomationProperties.Name="Logs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <InfoBar
                    x:Name="ErrorBar"
                    Grid.Row="0"
                    IsOpen="False"
                    Severity="Error"
                    IsClosable="True"
                    Title="OpenJarvis needs attention" />
                <Frame x:Name="ContentFrame" Grid.Row="1" IsTabStop="True" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
