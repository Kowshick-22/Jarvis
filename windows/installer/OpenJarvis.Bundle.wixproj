<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <Platform>ARM64</Platform>
    <MsiPath Condition="'$(MsiPath)' == ''">bin\$(Configuration)\net6.0-windows\OpenJarvis.Installer.msi</MsiPath>
    <DefineConstants>MsiPath=$(MsiPath)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="5.0.2" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Package.wxs;Files.wxs" />
    <Compile Include="Bundle.wxs" />
  </ItemGroup>
</Project>
